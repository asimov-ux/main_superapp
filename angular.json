{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "people-superapp": {
      "projectType": "application",
      "root": "projects/people-superapp",
      "sourceRoot": "projects/people-superapp/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/people-superapp",
            "index": "projects/people-superapp/src/index.html",
            "browser": "projects/people-superapp/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/people-superapp/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/people-superapp/public",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "projects/people-superapp/src/assets",
                "output": "assets"
              }
            ],
            "styles": ["projects/people-superapp/src/styles.scss"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "people-superapp:build:production"
            },
            "development": {
              "buildTarget": "people-superapp:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "core": {
      "projectType": "library",
      "root": "projects/core",
      "sourceRoot": "projects/core/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/core/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "ui-widgets": {
      "projectType": "library",
      "root": "projects/ui-widgets",
      "sourceRoot": "projects/ui-widgets/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ui-widgets/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ui-widgets/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui-widgets/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "feature-beneficios": {
      "projectType": "library",
      "root": "projects/feature-beneficios",
      "sourceRoot": "projects/feature-beneficios/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/feature-beneficios/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/feature-beneficios/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/feature-beneficios/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "ui-tokens": {
      "projectType": "library",
      "root": "projects/ui-tokens",
      "sourceRoot": "projects/ui-tokens/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ui-tokens/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ui-tokens/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui-tokens/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/ui-tokens/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    },
    "feature-people": {
      "projectType": "library",
      "root": "projects/feature-people",
      "sourceRoot": "projects/feature-people/src",
      "prefix": "fp",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/feature-people/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/feature-people/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/feature-people/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/feature-people/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    },
    "feature-dashboard": {
      "projectType": "library",
      "root": "projects/feature-dashboard",
      "sourceRoot": "projects/feature-dashboard/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/feature-dashboard/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/feature-dashboard/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/feature-dashboard/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/feature-dashboard/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
