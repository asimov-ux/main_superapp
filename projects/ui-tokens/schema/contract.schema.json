{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrandTokensContract",
  "type": "object",
  "required": ["brandId", "properties"],
  "properties": {
    "brandId": {
      "type": "string",
      "minLength": 1
    },
    "properties": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "properties": {
            "primary": { "type": "string" },
            "secondary": { "type": "string" },
            "background": { "type": "string" },
            "surface": { "type": "string" }
          },
          "required": ["primary"]
        },
        "typography": {
          "type": "object",
          "properties": {
            "fontFamily": { "type": "string" },
            "size": {
              "type": "object",
              "properties": {
                "sm": { "type": "string" },
                "md": { "type": "string" },
                "lg": { "type": "string" }
              }
            }
          }
        },
        "elevation": {
          "type": "object",
          "properties": {
            "lg": { "type": "string" }
          }
        },
        "motion": {
          "type": "object",
          "properties": {
            "duration": {
              "type": "object",
              "properties": {
                "fast": { "type": "string" },
                "base": { "type": "string" },
                "slow": { "type": "string" }
              }
            }
          }
        },
        "density": {
          "type": "object",
          "properties": {
            "mode": { "type": "string" }
          }
        }
      }
    }
  }
}
